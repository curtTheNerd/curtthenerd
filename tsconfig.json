{
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["react", "react-dom", "vite-plugin-svgr/client"],
    "moduleResolution": "node",
    "module": "esnext",
    "target": "esnext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/components", "src/custom.d.ts"]
}
